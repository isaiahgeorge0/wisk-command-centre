{
  "mailer_subjects_confirmation": "Confirm your WISK account",
  "mailer_templates_confirmation_content": "<div style=\"background:#0a0a0a;padding:40px 24px;font-family:-apple-system,Helvetica,Arial,sans-serif;\">\n  <div style=\"max-width:480px;margin:0 auto;\">\n    <img src=\"https://app.wiskapp.com/PNG-MAIN-WISK-LOGO-WHITE.png\" alt=\"WISK\" height=\"28\" style=\"margin-bottom:32px;\" />\n    <h1 style=\"color:#ffffff;font-size:20px;font-weight:600;margin:0 0 12px;\">Confirm your email</h1>\n    <p style=\"color:#a3a3a3;font-size:15px;line-height:1.5;margin:0 0 28px;\">You're almost in. Confirm your email to finish setting up your WISK account.</p>\n    <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#c3ff32;color:#0a0a0a;font-weight:600;font-size:14px;padding:12px 24px;border-radius:8px;text-decoration:none;\">Confirm email</a>\n    <p style=\"color:#666666;font-size:13px;line-height:1.5;margin:32px 0 0;\">If you didn't create a WISK account, you can ignore this email.</p>\n  </div>\n</div>",
  "mailer_subjects_invite": "You're invited to WISK",
  "mailer_templates_invite_content": "<div style=\"background:#0a0a0a;padding:40px 24px;font-family:-apple-system,Helvetica,Arial,sans-serif;\">\n  <div style=\"max-width:480px;margin:0 auto;\">\n    <img src=\"https://app.wiskapp.com/PNG-MAIN-WISK-LOGO-WHITE.png\" alt=\"WISK\" height=\"28\" style=\"margin-bottom:32px;\" />\n    <h1 style=\"color:#ffffff;font-size:20px;font-weight:600;margin:0 0 12px;\">You've been invited</h1>\n    <p style=\"color:#a3a3a3;font-size:15px;line-height:1.5;margin:0 0 28px;\">WISK is invite-only — someone thought you'd be a good fit. Accept your invite to get started.</p>\n    <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#c3ff32;color:#0a0a0a;font-weight:600;font-size:14px;padding:12px 24px;border-radius:8px;text-decoration:none;\">Accept invite</a>\n    <p style=\"color:#666666;font-size:13px;line-height:1.5;margin:32px 0 0;\">This invite was sent by a WISK user. If you weren't expecting this, you can ignore it.</p>\n  </div>\n</div>",
  "mailer_subjects_magic_link": "Your WISK sign-in link",
  "mailer_templates_magic_link_content": "<div style=\"background:#0a0a0a;padding:40px 24px;font-family:-apple-system,Helvetica,Arial,sans-serif;\">\n  <div style=\"max-width:480px;margin:0 auto;\">\n    <img src=\"https://app.wiskapp.com/PNG-MAIN-WISK-LOGO-WHITE.png\" alt=\"WISK\" height=\"28\" style=\"margin-bottom:32px;\" />\n    <h1 style=\"color:#ffffff;font-size:20px;font-weight:600;margin:0 0 12px;\">Sign in to WISK</h1>\n    <p style=\"color:#a3a3a3;font-size:15px;line-height:1.5;margin:0 0 28px;\">Click below to sign in. This link expires shortly and can only be used once.</p>\n    <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#c3ff32;color:#0a0a0a;font-weight:600;font-size:14px;padding:12px 24px;border-radius:8px;text-decoration:none;\">Sign in</a>\n    <p style=\"color:#666666;font-size:13px;line-height:1.5;margin:32px 0 0;\">If you didn't request this, you can safely ignore this email.</p>\n  </div>\n</div>",
  "mailer_subjects_email_change": "Confirm your new email address",
  "mailer_templates_email_change_content": "<div style=\"background:#0a0a0a;padding:40px 24px;font-family:-apple-system,Helvetica,Arial,sans-serif;\">\n  <div style=\"max-width:480px;margin:0 auto;\">\n    <img src=\"https://app.wiskapp.com/PNG-MAIN-WISK-LOGO-WHITE.png\" alt=\"WISK\" height=\"28\" style=\"margin-bottom:32px;\" />\n    <h1 style=\"color:#ffffff;font-size:20px;font-weight:600;margin:0 0 12px;\">Confirm your new email</h1>\n    <p style=\"color:#a3a3a3;font-size:15px;line-height:1.5;margin:0 0 28px;\">Confirm {{ .NewEmail }} as the new email address for your WISK account.</p>\n    <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#c3ff32;color:#0a0a0a;font-weight:600;font-size:14px;padding:12px 24px;border-radius:8px;text-decoration:none;\">Confirm new email</a>\n    <p style=\"color:#666666;font-size:13px;line-height:1.5;margin:32px 0 0;\">If you didn't request this change, you can safely ignore this email.</p>\n  </div>\n</div>",
  "mailer_subjects_recovery": "Reset your WISK password",
  "mailer_templates_recovery_content": "<div style=\"background:#0a0a0a;padding:40px 24px;font-family:-apple-system,Helvetica,Arial,sans-serif;\">\n  <div style=\"max-width:480px;margin:0 auto;\">\n    <img src=\"https://app.wiskapp.com/PNG-MAIN-WISK-LOGO-WHITE.png\" alt=\"WISK\" height=\"28\" style=\"margin-bottom:32px;\" />\n    <h1 style=\"color:#ffffff;font-size:20px;font-weight:600;margin:0 0 12px;\">Reset your password</h1>\n    <p style=\"color:#a3a3a3;font-size:15px;line-height:1.5;margin:0 0 28px;\">We received a request to reset your password. Choose a new one below.</p>\n    <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#c3ff32;color:#0a0a0a;font-weight:600;font-size:14px;padding:12px 24px;border-radius:8px;text-decoration:none;\">Reset password</a>\n    <p style=\"color:#666666;font-size:13px;line-height:1.5;margin:32px 0 0;\">If you didn't request this, you can safely ignore this email — your password won't change.</p>\n  </div>\n</div>",
  "mailer_subjects_reauthentication": "{{ .Token }} is your WISK verification code",
  "mailer_templates_reauthentication_content": "<div style=\"background:#0a0a0a;padding:40px 24px;font-family:-apple-system,Helvetica,Arial,sans-serif;\">\n  <div style=\"max-width:480px;margin:0 auto;\">\n    <img src=\"https://app.wiskapp.com/PNG-MAIN-WISK-LOGO-WHITE.png\" alt=\"WISK\" height=\"28\" style=\"margin-bottom:32px;\" />\n    <h1 style=\"color:#ffffff;font-size:20px;font-weight:600;margin:0 0 12px;\">Verify it's you</h1>\n    <p style=\"color:#a3a3a3;font-size:15px;line-height:1.5;margin:0 0 28px;\">Use this code to confirm a sensitive change on your WISK account.</p>\n    <div style=\"background:#161616;border-radius:8px;padding:16px 24px;display:inline-block;\">\n      <span style=\"color:#c3ff32;font-size:24px;font-weight:700;letter-spacing:4px;\">{{ .Token }}</span>\n    </div>\n    <p style=\"color:#666666;font-size:13px;line-height:1.5;margin:32px 0 0;\">This code expires shortly. If you didn't request this, you can safely ignore this email.</p>\n  </div>\n</div>"
}
